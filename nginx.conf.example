# Contoh konfigurasi nginx untuk FeedDesigner
# Copy ke /etc/nginx/sites-available/feeddesigner lalu symlink ke sites-enabled
#
# Ganti:
#   - yourdomain.com → domain kamu
#   - /path/to/FeedDesigner → path absolut ke folder project
#   - SSL paths → sesuaikan dengan Let's Encrypt atau cert kamu

server {
    listen 80;
    server_name yourdomain.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name yourdomain.com;

    ssl_certificate /etc/letsencrypt/live/yourdomain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/yourdomain.com/privkey.pem;

    # Proxy API requests to Express
    location /api/ {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Serve static assets from dist/ with long cache
    location /assets/ {
        alias /path/to/FeedDesigner/dist/assets/;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # PWA files
    location = /manifest.json { alias /path/to/FeedDesigner/dist/manifest.json; }
    location = /sw.js { alias /path/to/FeedDesigner/dist/sw.js; add_header Cache-Control "no-cache"; }
    location = /robots.txt { alias /path/to/FeedDesigner/dist/robots.txt; }
    location = /icon-192.png { alias /path/to/FeedDesigner/dist/icon-192.png; }
    location = /icon-512.png { alias /path/to/FeedDesigner/dist/icon-512.png; }
    location = /apple-touch-icon.png { alias /path/to/FeedDesigner/dist/apple-touch-icon.png; }

    # SPA fallback — semua route yang bukan /api/ atau file statis
    # diarahkan ke index.html agar client-side router bisa handle
    location / {
        root /path/to/FeedDesigner/dist;
        try_files $uri $uri/ /index.html;
    }
}
