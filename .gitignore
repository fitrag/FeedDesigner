# ---------- Dependencies ----------
node_modules/
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ---------- Build output ----------
dist/
dist-ssr/
build/
*.tsbuildinfo

# Vite cache
.vite/
.vite-cache/

# ---------- Secrets & local config ----------
.env
.env.local
.env.*.local
.env.development
.env.production
# Keep the example committed so others know which vars exist.
!.env.example

# ---------- Runtime data ----------
# SQLite databases, WAL/SHM sidecars, stored images, uploads, auth secret.
# Everything under data/ is machine-local state — never commit.
data/
*.sqlite
*.sqlite-journal
*.db
*.db-shm
*.db-wal

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dev.log
dev-current.log
dev-current.err.log

# ---------- Editor / IDE ----------
# Keep .vscode/ committed if the repo wants to share recommended settings;
# here we exclude workspace-specific noise while allowing shared configs
# if they're explicitly added with `git add -f`.
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.swn
*.iml

# ---------- OS artifacts ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---------- Test & coverage ----------
coverage/
.nyc_output/
*.lcov

# ---------- Temporary / scratch ----------
tmp/
temp/
scripts/tmp-*
