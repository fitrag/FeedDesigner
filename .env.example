# ---------- AI provider ----------
# Default points to a proxy used for development. For production, point this
# to api.openai.com/v1 or another provider you trust with your key.
OPENAI_BASE_URL=https://r5d6xug.9router.com/v1
OPENAI_API_KEY=isi_api_key_anda
OPENAI_IMAGE_MODEL=cx/gpt-5.4

# ---------- Server ----------
PORT=8787

# HMAC secret for auth tokens. If empty, the server auto-generates one and
# persists it under data/.auth-secret (file mode 0600). Set an explicit long
# random value in production so deploys are reproducible.
# AUTH_SECRET=

# JWT-like token lifetime in seconds. Defaults to 7 days.
# AUTH_TOKEN_TTL_SECONDS=604800

# Require cookies to be sent over HTTPS only. ALWAYS set this to "true" in
# production. Leaving it false is fine for local development over http.
# SECURE_COOKIES=true

# When running behind a reverse proxy (nginx, cloudflare, ngrok), set to "true"
# so req.ip reflects the real client and rate-limit keying works per user.
# TRUST_PROXY=true

# Comma-separated list of allowed origins for CORS. When empty, any origin is
# accepted (convenient for dev + tunnels). Set a strict list in production.
# Example: https://feeddesigner.example.com,https://app.example.com
# CORS_ORIGINS=

# Override the CSP `script-src` additions. Vite dev needs `'unsafe-eval'`; in
# a static build served without a dev server you can drop it: set to a single
# space or override with a hash/nonce policy.
# CSP_SCRIPT_SRC='unsafe-eval'
